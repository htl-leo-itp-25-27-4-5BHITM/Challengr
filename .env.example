# Docker Compose Environment Variables
# Vorlage: nach .env.local kopieren und lokale Werte eintragen (.env.local ist nicht im Git).

# PostgreSQL
POSTGRES_DB=<bitte-setzen>
POSTGRES_USER=<bitte-setzen>
POSTGRES_PASSWORD=<bitte-setzen>

# Quarkus Backend
QUARKUS_DATASOURCE_JDBC_URL=<bitte-setzen>
QUARKUS_DATASOURCE_USERNAME=<bitte-setzen>
QUARKUS_DATASOURCE_PASSWORD=<bitte-setzen>
QUARKUS_PROFILE=<bitte-setzen>

# Dashboard
BACKEND_URL=<bitte-setzen>
